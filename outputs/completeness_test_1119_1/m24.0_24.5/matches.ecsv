# meta: !!omap
# - {match_radius_pixels: 3.0}
# - {matching_rule: Only mutually unique candidates can be matched}
# - {isolation_rule: match_radius + crowding_radius}
# - {injection_overlap_rule: Flag pairs closer than crowding_radius_i + crowding_radius_j}
# - {warning: 'Conservative centre-only candidate matching, not a deblender or a global optimal assignment. Ambiguous, shared and crowded
#     cases are not automatically clean recoveries. No input/output flux-agreement cut is applied.'}
# - {selection_note: 'detection_recovered includes near_injected but excludes nearby baseline sources, shared and ambiguous candidates.
#     photometry_recovered also requires usable positive finite flux. clean_usable_recovery further excludes nearby injections.'}
