# meta: !!omap
# - {description: Unclassified source candidates; usable is a conservative photometry-quality flag.}
# - {flux_note: Signed observed ADU in unchanged binary apertures; no neighbour subtraction. Positive light is used only for quality ratios
#     and approximate shot noise.}
# - {input_catalogue_sha256: d9d6199341a60bba55add9ac7a13b62fc02ea82ad321c5c4c54bdad88dd8591b}
# - {review: Pixel-based quality review; no profile fitting. Original quality columns remain historical; use usable and flags for current
#     selection.}
# - {snr_note: Independent-pixel RMS plus positive signal/GAIN; correlated noise is not calibrated.}
# - {limits: label area 0.03; label light 0.02; shared light 0.02; SNR 5.0; close distance 1.25; bridge SNR 3.0; pair peak SNR 5.0}
# - {magnitude_convention: MAGZPT - 2.5 log10(flux_ADU * GAIN / EXPTIME)}
# - {classification_note: Remaining includes uncertain sources; not confirmed galaxies.}
# - {width_method: 'circular Moffat with 3x3 Gauss-Legendre pixel integration, radius 9 pixels'}
# - {classification_warning: 'Width-based candidates only. Automatic reference selection is provisional; inspect references and candidates.
#     Compact galaxies can be star candidates. Thresholds are initial choices, not calibrated classification probabilities.'}
# - {classification_mag_limit: 21.0}
# - {reference_selection: automatic width peak}
# - {error_note: 'Independent-pixel RMS variance + F_ADU/GAIN shot variance; no blank-aperture correction. First-order magnitude errors
#     include shared MAGZRR and are stored, not plotted.'}
# - {input_sources_sha256: 8d648516e534fd71679fd4918bbca6ffcf682b12f5bc39121b17b06c72b23065}
# - {input_products_sha256: c4634a688293190a5efaa67686f027f03081f600a3e044147d630df617dd4863}
# - {measurement_mag_limit: 22.0}
# - {area_deg2: 0.05260726520555556}
# - {sample_note: Unknown sources retained in counts; remaining sources are not confirmed galaxies.}
# - {width_note: 'Circular Moffat FWHM, before pixel integration; not a half-light radius.'}
# - {calibration_assumption: MAGZPT refers to electrons/second; header GAIN used as effective gain.}
# - {mc_draws: 2000}
# - {random_seed: 20261118}
# - {descriptive_slope: 0.3803405834271075}
# - fit_range: [18.5, 22.0]
# - {descriptive_slope_error: 0.017651668169222007}
# - {slope_error_note: 'Observed unweighted np.polyfit(degree=1); parameter errors are the sample standard deviations (ddof=1) of fits
#     to Monte Carlo log-density curves at the same fit points. Includes Poisson, flux and shared zero-point perturbations, preserving
#     cumulative-count correlations. Trials with nonpositive counts at any fit point are skipped and recorded. No completeness, classification
#     or cosmic-variance errors.'}
