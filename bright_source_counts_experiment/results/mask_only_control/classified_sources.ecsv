# meta: !!omap
# - {description: Unclassified source candidates; usable is a conservative photometry-quality flag.}
# - {flux_note: Raw signed aperture sum; neighbour model not subtracted. Recovered sources need validation.}
# - {input_catalogue_sha256: c41b283b0e15e436d77898e5496ec705d63edf20185d85d7f03dd71c86b010e3}
# - {model_settings: '{"max_overlap_area_fraction": 0.15, "max_overlap_flux_fraction": 0.1, "profile_betas": [2.5, 4.0], "max_group_sources":
#     24, "max_fit_pixels": 30000, "max_nfev": 200, "max_reduced_residual": 5.0, "max_coherent_residual": 5.0, "max_score_disagreement":
#     0.03, "minimum_model_snr": 10.0, "minimum_aperture_snr": 5.0, "max_centre_shift": 1.5, "max_fractional_residual": 0.08, "max_bound_neighbour_fraction":
#     0.02, "max_sky_flux_fraction": 0.05}'}
# - {model_version: 3}
# - {snr_note: Aperture sum / sqrt(sum(background RMS^2 + positive signal / GAIN)); no correlated-noise correction.}
# - {score_note: 'Free elliptical Moffat proxy; two initialisations check solution stability, not model-family uncertainty or a confidence
#     bound.'}
# - {area_note: Mean N/(S+N) over aperture pixels; not binary label-overlap area.}
# - {control_note: Only new masks applied; original apertures/fluxes/detection unchanged.}
# - {magnitude_convention: MAGZPT - 2.5 log10(flux_ADU * GAIN / EXPTIME)}
# - {classification_note: Remaining includes uncertain sources; not confirmed galaxies.}
# - {width_method: 'circular Moffat with 3x3 Gauss-Legendre pixel integration, radius 9 pixels'}
# - {profile_residual_limit: 0.10951764379438086}
# - {psf_quality_mode: reference_profile}
# - {classification_warning: 'Width-based candidates only. Automatic reference selection is provisional; inspect references and candidates.
#     Compact galaxies can be star candidates. Thresholds are initial choices, not calibrated classification probabilities.'}
# - {classification_mag_limit: 22.0}
# - {reference_selection: supplied labels}
# - {error_note: Translated blank-aperture background scatter plus F_ADU/GAIN shot variance; MAGZRR is common to all sources. No flux
